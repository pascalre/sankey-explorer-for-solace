# Copy to .env and fill in. .env is gitignored.

PORT=4000
NODE_ENV=development

# Session signing secret - OPTIONAL. If left empty, a random one is
# generated each time the process starts (safe here - see config.ts - since
# sessions/broker connections are in-memory only anyway and don't survive a
# restart regardless). Only set this yourself if you run multiple replicas
# that need to share one signing secret, e.g.: openssl rand -hex 32
SESSION_SECRET=

# App login (access gate for the tool itself). Leave BOTH empty = no login
# ("workshop mode" - the customer's network boundary is then the access control).
# Set APP_USERNAME and generate the hash with: npm run hash-password
APP_USERNAME=
APP_PASSWORD_HASH=

# Throttling for SEMP requests (Solace recommends <=10/s). Does NOT need to
# be set per broker connection - broker URL/user/password/VPN are entered
# at runtime via the "Connect to Broker" screen in the UI.
SEMP_MIN_REQUEST_INTERVAL_MS=200
